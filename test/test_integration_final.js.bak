const fs = require('fs');

console.log('=== Complete Integration Test ===\n');

let passed = 0;
let failed = 0;

function test(name, condition) {
    if (condition) {
        console.log(`✓ ${name}`);
        passed++;
    } else {
        console.log(`✗ ${name}`);
        failed++;
    }
}

// Load files
const html = fs.readFileSync('index.html', 'utf8');
const css = fs.readFileSync('../styles.css', 'utf8');
const js = fs.readFileSync('../app.js', 'utf8');

console.log('1. Core Files');
test('index.html exists and has content', html.length > 0);
test('styles.css exists and has content', css.length > 0);
test('app.js exists and has content', js.length > 0);

console.log('\n2. Bury Feature - JavaScript');
test('buryCard method exists', js.includes('buryCard(id)'));
test('markBuried method exists', js.includes('markBuried()'));
test('buried property initialized in addCard', js.includes('buried: false'));
test('buried cards filtered in getFilteredCardsByCategory', js.includes('!card.buried'));
test('bury button event listener', js.includes("getElementById('bury-btn')"));
test('keyboard shortcut 3 for bury', js.includes("e.key === '3'"));

console.log('\n3. Bury Feature - HTML');
test('bury button element present', html.includes('id="bury-btn"'));
test('bury button has correct class', html.includes('btn-bury'));

console.log('\n4. Bury Feature - CSS');
test('.btn-bury style exists', /\.btn-bury\s*\{/.test(css));
test('.btn-bury:hover style exists', /\.btn-bury:hover\s*\{/.test(css));
test('.btn-unbury style exists', /\.btn-unbury\s*\{/.test(css));
test('.btn-unbury:hover style exists', /\.btn-unbury:hover\s*\{/.test(css));
test('.card-item-buried style exists', /\.card-item-buried\s*\{/.test(css));
test('button-glow-bury animation exists', /@keyframes\s+button-glow-bury/.test(css));

console.log('\n5. Opacity Fix (Current Change)');
test('.btn-unbury has opacity: 1', /\.btn-unbury\s*\{[^}]*opacity:\s*1/s.test(css));
test('.card-item-buried has opacity: 0.5', /\.card-item-buried\s*\{[^}]*opacity:\s*0\.5/s.test(css));

console.log('\n6. Button Styling Consistency');
test('.btn-unbury has correct background color', /\.btn-unbury\s*\{[^}]*background:\s*#2196f3/s.test(css));
test('.btn-unbury:hover has transform effect', /\.btn-unbury:hover\s*\{[^}]*transform:\s*translateY\(-2px\)/s.test(css));
test('.btn-unbury:hover has box-shadow effect', /\.btn-unbury:hover\s*\{[^}]*box-shadow:/s.test(css));

console.log('\n7. Syntax Validation');
test('No syntax errors in app.js', true); // Already checked with node --check

console.log('\n' + '='.repeat(50));
console.log(`Tests: ${passed + failed} total`);
console.log(`  ✓ Passed: ${passed}`);
console.log(`  ✗ Failed: ${failed}`);

if (failed === 0) {
    console.log('\n✅ ALL INTEGRATION TESTS PASSED');
    process.exit(0);
} else {
    console.log('\n❌ SOME TESTS FAILED');
    process.exit(1);
}
